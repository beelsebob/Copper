// Machine-specific settings for dependencies which live outside this repository.
//
// Override any of these on the xcodebuild command line, in Xcode's build settings, or by creating
// an untracked BuildPaths.local.xcconfig alongside this file (Scripts/check_dependencies.py writes
// one when this machine differs from the defaults below).
HOMEBREW_PREFIX = /opt/homebrew
// Homebrew's VTK puts its major.minor version in header directory and library names (vtk-9.6,
// -lvtkCommonCore-9.6); Scripts/check_dependencies.py overrides it to match the installed VTK.
VTK_VERSION = 9.6

// Fails every compile with an #error until Scripts/check_dependencies.py has passed on this machine.
OTHER_CFLAGS = $(inherited) -include $(SRCROOT)/Config/DependencyCheck.h

#include? "BuildPaths.local.xcconfig"
